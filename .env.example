# ==============================================================================
# WRITE DESK — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or real production secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Secret Key (used for cryptographic HMAC-SHA256 session tokens)
# Minimum 32 characters in production. Generate using: openssl rand -hex 32
APP_SECRET=replace_with_a_secure_random_32_byte_hex_string

# Administrator Credentials
ADMIN_EMAIL=admin@writedesk.in
# PBKDF2 hash of admin password (salt:hash hex).
# Default dev password "Admin@WriteDesk2026!"
ADMIN_PASSWORD_HASH=8f4e2c9a6b1d3f5e7a9c8b7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f

# Payment Gateway Secrets (Razorpay / Stripe)
PAYMENT_KEY_ID=rzp_test_sample_key_id
PAYMENT_KEY_SECRET=sample_payment_key_secret_do_not_commit
PAYMENT_WEBHOOK_SECRET=sample_webhook_signing_secret_do_not_commit

# CORS Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session Configuration
SESSION_MAX_AGE_SECONDS=86400

# File Upload Storage (optional cloud bucket config)
UPLOAD_STORAGE_DRIVER=local
MAX_FILE_SIZE_MB=25
